APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///data/app.db

ARTIFACT_ROOT=data
SCREENSHOTS_DIR=data/screenshots
PROCESSED_DIR=data/processed
DIFFS_DIR=data/diffs
LOGS_DIR=data/logs

ENABLE_SCHEDULER=true
ENABLE_BOT=true
MONITOR_INTERVAL_SECONDS=120
RUN_ONCE=false

TELEGRAM_BOT_TOKEN=

API_HOST=0.0.0.0
API_PORT=8000
DEV_AUTH_ENABLED=true
ALLOWED_TELEGRAM_USER_IDS=
ADMIN_TELEGRAM_USER_IDS=
ADMIN_BYPASS_TARIFF_LIMITS=true

SELENIUM_PAGE_LOAD_TIMEOUT_SECONDS=25
SELENIUM_WAIT_TIMEOUT_SECONDS=20
CHROME_HEADLESS=true
CHROME_BINARY_PATH=/usr/bin/chromium
CHROMEDRIVER_PATH=/usr/bin/chromedriver

CV_MASK_MODE=bgr
CV_TARGET_BGR_B=207
CV_TARGET_BGR_G=109
CV_TARGET_BGR_R=202
CV_TOLERANCE=28
CV_HUE_MIN=118
CV_HUE_MAX=179
CV_SAT_MIN=8
CV_SAT_MAX=240
CV_VAL_MIN=85
CV_VAL_MAX=255
CV_MORPH_KERNEL_SIZE=3
CV_MIN_AREA=120
CV_MIN_PERIMETER=45
CV_MIN_COMPACTNESS=0.03
CV_MAX_COMPACTNESS=0.86

ZONE_MATCH_MAX_CENTROID_DISTANCE=32
ZONE_MATCH_MIN_IOU=0.08
ZONE_MATCH_MAX_AREA_DELTA_RATIO=0.55

MAX_ITEMS_TRIAL_FREE=1
MAX_ITEMS_BASE=5
MAX_ITEMS_PRO=20
TRIAL_DAYS=3


